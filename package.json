{
  "name": "pjbl-sptldv-tata-boga",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Platform PjBL Sistem Pertidaksamaan Linear Dua Variabel untuk SMK Tata Boga",
  "scripts": {
    "dev": "tsx dev-server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "bundle": "esbuild worker/index.ts --bundle --format=esm --minify --legal-comments=none --outfile=deploy/worker-bundle.js",
    "preview": "npm run build && tsx dev-server.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "cf:db:init": "wrangler d1 execute pjbl-sptldv --remote --file=./schema.sql",
    "cf:db:init:local": "wrangler d1 execute pjbl-sptldv --local --file=./schema.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.1",
    "better-sqlite3": "^11.3.0",
    "hono": "^4.6.3",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.7",
    "wrangler": "^3.78.4"
  }
}
